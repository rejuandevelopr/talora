---
import Img from './Img.astro';
import Icon from './Icon.astro';
import { photos } from '../data/images';
---
<section id="cta" class="container-x py-16 sm:py-24">
  <div class="img-shell relative isolate overflow-hidden rounded-[32px] px-6 py-20 sm:px-14 sm:py-24" data-reveal>
    <Img id={photos.milkyWay} alt="" widths={[640, 960, 1600, 2200]} sizes="(min-width: 1480px) 1400px, 100vw" class="absolute inset-0 -z-10 size-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950/95 via-ink-950/60 to-ink-950/10"></div>
    <div class="absolute -bottom-24 -left-10 -z-10 h-64 w-96 rounded-full bg-amber/25 blur-[100px]"></div>
    <div class="max-w-xl">
      <h2 class="text-3xl font-medium leading-[1.1] tracking-[-0.035em] sm:text-[46px]">Give your clients a <span class="serif-accent text-amber-soft">better experience</span>, starting this week.</h2>
      <p class="mt-4 max-w-md text-[14px] leading-relaxed text-white/75">Set up your portal in about ten minutes. Import clients from a spreadsheet and send your first invoice today.</p>
      <form action="/signup" method="get" class="mt-8 flex max-w-md flex-col gap-2 rounded-full sm:flex-row sm:bg-ink-950/50 sm:p-1.5 sm:ring-1 sm:ring-white/15 sm:backdrop-blur">
        <label for="cta-email" class="sr-only">Work email</label>
        <input id="cta-email" name="email" type="email" required placeholder="you@studio.com" class="min-w-0 flex-1 rounded-full bg-ink-950/50 px-4 py-2.5 text-[13px] text-white placeholder:text-white/45 outline-none ring-1 ring-white/15 focus:ring-amber/60 sm:bg-transparent sm:ring-0" />
        <button class="btn-amber justify-center !py-2.5">Start free trial</button>
      </form>
      <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[12px] text-white/60">
        <span class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-amber" />No card required</span>
        <span class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-amber" />Free migration help</span>
        <a href="/app" class="flex items-center gap-1.5 underline underline-offset-4 hover:text-white">Or explore the demo</a>
      </p>
    </div>
  </div>
</section>
