---
import Img from './Img.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { photos } from '../data/images';
const year = new Date().getFullYear();
const cols = [
  { title: 'Product', links: [['Client portal', '/portal'], ['Dashboard demo', '/app'], ['AI briefs', '/app/briefs'], ['Pricing', '/pricing'], ['Changelog', '/changelog']] },
  { title: 'Company', links: [['About', '/about'], ['Customers', '/#stories'], ['Contact', '/contact'], ['Sign in', '/login']] },
  { title: 'Legal', links: [['Privacy policy', '/privacy'], ['Terms of service', '/terms'], ['Security', '/privacy#security']] },
];
---
<footer id="footer" class="img-shell relative isolate mt-10 overflow-hidden">
  <Img id={photos.heroDunes} alt="" widths={[640, 1280, 1920, 2400]} sizes="100vw" class="absolute inset-0 -z-20 size-full object-cover object-[50%_70%]" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink-950 via-ink-950/70 to-ink-950/10"></div>
  <div class="absolute bottom-0 left-1/2 -z-10 h-72 w-[70%] -translate-x-1/2 rounded-full bg-amber/20 blur-[120px]" aria-hidden="true"></div>

  <div class="container-x grid grid-cols-3 gap-x-6 gap-y-12 pt-16 md:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div class="col-span-3 md:col-span-1">
      <p class="flex items-center gap-2 text-xl font-semibold tracking-tight"><Logo class="size-6" />Talora</p>
      <p class="mt-3 max-w-xs text-[14px] leading-relaxed text-white/75">The client workspace for studios and agencies. Made with care for people who make things.</p>
      <div class="mt-5 flex gap-3 text-white/70">
        {[['X', 'xsocial'], ['LinkedIn', 'linkedin'], ['Dribbble', 'dribbble'], ['Instagram', 'instagram']].map(([l, i]) => (
          <a href="#" aria-label={l} class="grid size-9 place-items-center rounded-full bg-white/5 ring-1 ring-white/10 hover:text-amber"><Icon name={i} class="size-4" /></a>
        ))}
      </div>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <p class="text-[13px] font-semibold">{c.title}</p>
        <ul class="mt-3 space-y-2 text-[13px] text-white/60">
          {c.links.map(([l, h]) => <li><a href={h} class="transition hover:text-amber-soft">{l}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>

  <p class="wordmark pointer-events-none mt-14 select-none text-center font-serif font-light italic leading-[0.8] tracking-[-0.04em] text-[29vw] translate-y-[10%]" aria-hidden="true">Talora</p>
  <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-4 text-[11px] text-white/55">
    <span>© {year} Talora Inc.</span>
  </div>
</footer>

<style>
  .wordmark {
    background: linear-gradient(180deg, rgba(247, 197, 138, 0.85) 0%, rgba(245, 238, 227, 0.25) 70%, rgba(245, 238, 227, 0) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
