---
import { avatar } from '../data/images';
interface Props { id: string; name: string; size?: number; class?: string }
const { id, name, size = 32, class: cls = '' } = Astro.props;
const initials = name.split(' ').map((p) => p[0]).slice(0, 2).join('');
---
<span class={`relative inline-grid shrink-0 place-items-center overflow-hidden rounded-full bg-gradient-to-br from-amber/70 to-ember/70 font-semibold text-ink-950 ${cls}`} style={`width:${size}px;height:${size}px;font-size:${Math.max(8, size * 0.36)}px`}>
  <span aria-hidden="true">{initials}</span>
  <img src={avatar(id, size * 2)} alt={name} width={size} height={size} loading="lazy" decoding="async" onerror="this.remove()" class="absolute inset-0 size-full object-cover text-[0px]" />
</span>
