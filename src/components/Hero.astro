---
import Img from './Img.astro';
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import SiteNav from './SiteNav.astro';
import { photos, people } from '../data/images';

const brands = ['Northfold', 'Kiln Studio', 'PARALLEL', 'Oakhaus', 'Lumen & Co', 'fieldwork', 'Vantage', 'Studio Mono'];
const brandStyle = [
  'font-serif italic text-xl',
  'font-semibold tracking-tight text-lg',
  'tracking-[0.3em] text-sm font-medium',
  'font-bold text-lg',
  'font-serif text-xl',
  'font-extrabold lowercase tracking-tight text-lg',
  'font-light tracking-[0.12em] uppercase text-base',
  'font-medium text-lg',
];
const proof: [string, string][] = [[people.amara, 'Amara Okafor'], [people.jonas, 'Jonas Weber'], [people.priya, 'Priya Nair'], [people.tom, 'Tom Ashby']];
---
<SiteNav overlay />
<header class="px-2 pt-2 sm:px-3 sm:pt-3">
  <div class="img-shell relative isolate mx-auto max-w-[1880px] overflow-hidden rounded-[28px] sm:rounded-[32px]">
    <Img id={photos.heroDunes} alt="" eager widths={[640, 960, 1280, 1920, 2560]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover object-[50%_65%]" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink-950/70 via-ink-950/15 to-ink-950" aria-hidden="true"></div>
    <div class="absolute left-1/2 top-1/3 -z-10 h-80 w-[60%] -translate-x-1/2 rounded-full bg-amber/20 blur-[120px]" aria-hidden="true"></div>

    <div class="relative z-10 flex min-h-[640px] flex-col items-center px-5 pb-44 pt-32 text-center sm:min-h-[740px] sm:pt-44 lg:min-h-[840px]">
      <a href="/changelog" class="animate-fade-up group inline-flex items-center gap-3 rounded-full bg-ink-950/30 py-1.5 pl-3.5 pr-3 text-[11px] uppercase tracking-[0.16em] text-white/70 ring-1 ring-white/12 backdrop-blur-md transition hover:text-white hover:ring-white/25">
        <span class="text-white/90"><span class="sm:hidden">New</span><span class="hidden sm:inline">New in Talora</span></span>
        <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
        <span class="whitespace-nowrap normal-case tracking-normal text-[12px]">AI briefs from your call notes</span>
        <Icon name="arrow" class="size-3.5 transition group-hover:translate-x-0.5" />
      </a>
      <h1 class="animate-fade-up mt-7 max-w-[17ch] text-[42px] font-medium leading-[1.03] tracking-[-0.045em] [animation-delay:80ms] sm:text-6xl lg:text-[80px]">
        Every client, project and invoice in <span class="serif-accent text-amber-soft">one calm</span> workspace.
      </h1>
      <p class="animate-fade-up mt-6 max-w-xl text-[15px] leading-relaxed text-white/75 [animation-delay:160ms] sm:text-base">
        Talora gives studios and agencies a shared home for briefs, approvals, timelines and payments. Less chasing, more making.
      </p>
      <div class="animate-fade-up mt-8 flex flex-wrap items-center justify-center gap-3 [animation-delay:240ms]">
        <a href="/signup" class="btn-amber !px-5 !py-2.5">Start free for 14 days</a>
        <a href="/app" class="btn-ghost !px-5 !py-2.5"><Icon name="play" class="size-3.5 fill-current" />Explore the live demo</a>
      </div>
      <div class="animate-fade-up mt-9 flex items-center gap-3 text-[12px] text-white/70 [animation-delay:320ms]">
        <span class="flex -space-x-2">
          {proof.map(([id, n]) => <Avatar id={id} name={n} size={26} class="ring-2 ring-ink-900" />)}
        </span>
        Loved by 2,400+ studios in 38 countries
      </div>
    </div>

    <div class="relative z-10 border-t border-white/5 bg-ink-950/60 py-7 backdrop-blur-sm">
      <p class="mb-5 text-center text-[11px] uppercase tracking-[0.2em] text-mist-400">Trusted by independent studios everywhere</p>
      <div class="overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]">
        <ul class="flex w-max animate-marquee-x items-center gap-16 pr-16 text-white/60 hover:[animation-play-state:paused]" aria-label="Customer logos">
          {[...brands, ...brands].map((b, i) => (
            <li class={`whitespace-nowrap ${brandStyle[i % brands.length]}`} aria-hidden={i >= brands.length ? 'true' : undefined}>{b}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>
