---
import SectionHead from './SectionHead.astro';
import Img from './Img.astro';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import { photos, people } from '../data/images';

const reviews = [
  { name: 'Amara Okafor', role: 'Founder, Kiln Studio', id: people.amara, text: 'Our clients finally stopped asking "where are we at?" Everything they need is in the portal, so our inbox got quiet overnight.' },
  { name: 'Jonas Weber', role: 'Ops Lead, Parallel', id: people.jonas, text: 'We replaced four tools with Talora. Briefs, approvals and invoices now flow into each other without anyone copying data around.' },
  { name: 'Priya Nair', role: 'Creative Director, Fieldwork', id: people.priya, text: 'Approvals used to take a week of back and forth. Now clients comment on the work directly and sign off in a click.' },
  { name: 'Tom Ashby', role: 'Producer, Oakhaus', id: people.tom, text: 'The timeline view is the first thing I open every morning. I can see every shoot and deadline across the studio at a glance.' },
  { name: 'Elena Rossi', role: 'COO, Northfold', id: people.elena, text: 'Invoices go out the moment a milestone is approved. Our average time to get paid dropped from 21 days to under a week.' },
  { name: 'Noah Kim', role: 'Independent designer', id: people.noah, text: 'As a one person studio, Talora makes me look like a much bigger team. The AI brief drafts alone save me hours a week.' },
];
const half = Math.ceil(reviews.length / 2);
const cols = [reviews.slice(0, half), reviews.slice(half)];
const stats = [['3.2x', 'faster client approvals'], ['6 days', 'average time to get paid'], ['11 hrs', 'saved per person, per week'], ['4.9/5', 'average rating from studios']];
---
<section id="stories" class="container-x py-24 sm:py-32">
  <SectionHead title="Studios that switched" accent="never looked back" text="From solo designers to 60 person agencies, teams use Talora to win back their week and give clients a calmer experience." />

  <div class="mt-14 grid overflow-hidden rounded-[28px] bg-ink-900 ring-1 ring-white/[0.07] lg:grid-cols-2" data-reveal>
    <div class="img-shell relative isolate order-2 h-[540px] overflow-hidden lg:order-1">
      <Img id={photos.valley} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 600px, 100vw" class="absolute inset-0 -z-10 size-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-ink-950/30"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-16 bg-gradient-to-b from-ink-950/70 to-transparent"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-16 bg-gradient-to-t from-ink-950/70 to-transparent"></div>
      <div class="grid h-full grid-cols-1 gap-3 px-4 sm:grid-cols-2">
        {cols.map((col, ci) => (
          <div class:list={['marquee overflow-hidden', ci === 1 && 'hidden sm:block']}>
            <ul class:list={['flex flex-col gap-3 pb-3 animate-marquee-y', ci === 1 && '[animation-direction:reverse]']}>
              {[...col, ...col].map((r, i) => (
                <li class="rounded-2xl bg-cream p-4 text-ink-950 shadow-lg shadow-black/25" aria-hidden={i >= col.length ? 'true' : undefined}>
                  <div class="flex gap-0.5 text-ember">{Array.from({ length: 5 }).map(() => <Icon name="star" class="size-3 fill-current" />)}</div>
                  <p class="mt-2.5 text-[12.5px] leading-relaxed text-ink-700">{r.text}</p>
                  <div class="mt-3 flex items-center gap-2.5 border-t border-ink-950/10 pt-3">
                    <Avatar id={r.id} name={r.name} size={30} />
                    <div class="text-[12px] leading-tight"><p class="font-semibold">{r.name}</p><p class="text-ink-500">{r.role}</p></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <figure class="order-1 flex flex-col justify-between gap-12 p-7 sm:p-10 lg:order-2">
      <div class="pt-4 lg:pt-14">
        <span class="font-serif text-7xl leading-none text-amber" aria-hidden="true">&ldquo;</span>
        <blockquote class="-mt-4 text-2xl leading-[1.3] tracking-[-0.02em] text-balance sm:text-[27px]">
          Talora changed how our clients feel about working with us. They see progress, give feedback and pay, all in one place. It is the calmest our studio has felt in years.
        </blockquote>
      </div>
      <figcaption class="flex items-center gap-3">
        <Avatar id={people.maya} name="Maya Ellison" size={40} />
        <span class="text-[13px]"><span class="block font-semibold">Maya Ellison</span><span class="text-mist-400">Managing Partner, Lumen &amp; Co</span></span>
      </figcaption>
    </figure>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-5 lg:grid-cols-4" data-reveal>
    {stats.map(([v, k]) => (
      <div class="rounded-2xl bg-ink-900 p-5 ring-1 ring-white/[0.07]">
        <dt class="sr-only">{k}</dt>
        <dd class="text-3xl font-semibold tracking-tight">{v}</dd>
        <dd class="mt-1 text-[13px] text-mist-400">{k}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .marquee:hover ul { animation-play-state: paused; }
</style>
